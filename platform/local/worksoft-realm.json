{
  "realm": "worksoft-local",
  "enabled": true,
  "registrationAllowed": false,
  "roles": {
    "realm": [
      {
        "name": "company:provision",
        "description": "Operador de aprovisionamiento de empresas"
      }
    ]
  },
  "clients": [
    {
      "clientId": "worksoft-local-cli",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "protocol": "openid-connect",
      "protocolMappers": [
        {
          "name": "company-service-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.custom.audience": "company-service",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        }
      ]
    }
  ]
}
